{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: widget tests",
      "type": "shell",
      "command": "dart",
      "args": ["run", "tool/build.dart", "test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Flutter: all UI tests",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ui_test.sh",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Flutter: build APK (balsm · dev)",
      "type": "shell",
      "command": "dart",
      "args": ["run", "tool/build.dart", "apk", "balsm", "dev"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Flutter: build APK (balsm · prod)",
      "type": "shell",
      "command": "dart",
      "args": ["run", "tool/build.dart", "apk", "balsm", "prod"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Flutter: build web (balsm · prod)",
      "type": "shell",
      "command": "dart",
      "args": ["run", "tool/build.dart", "web", "balsm", "prod"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
