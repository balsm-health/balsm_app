{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: code generation",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/build.dart",
        "gen"
      ],
      "problemMatcher": []
    },
    {
      "label": "Flutter: code generation (watch)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/build.dart",
        "gen",
        "--watch"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Flutter: widget tests (app only)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/build.dart",
        "test"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Flutter: all UI tests",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ui_test.sh",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Build: web",
      "type": "shell",
      "command": "fvm dart run tool/build.dart web balsm ${input:env}",
      "group": "build",
      "problemMatcher": [],
      "icon": {
        "id": "globe",
        "color": "terminal.ansiMagenta"
      }
    },
    {
      "label": "Dart: format",
      "type": "shell",
      "command": "dart",
      "args": [
        "format",
        "."
      ],
      "group": "format",
      "problemMatcher": []
    },
    {
      "label": "Flutter: all tests",
      "detail": "Every Dart test in the repo: each workspace package, then the root suites.",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/all_tests.sh",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build: Android APK (ad-hoc / direct install)",
      "type": "shell",
      "group": "build",
      "command": "fvm dart run tool/build.dart apk balsm ${input:env} --servers=${input:servers}",
      "problemMatcher": [],
      "icon": {
        "id": "device-mobile",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "Build: Android App Bundle (Play store)",
      "type": "shell",
      "group": "build",
      "command": "fvm dart run tool/build.dart aab balsm ${input:env} --servers=${input:servers}",
      "problemMatcher": [],
      "icon": {
        "id": "package",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "Build: iOS IPA (ad-hoc)",
      "type": "shell",
      "group": "build",
      "command": "fvm dart run tool/build.dart ipa balsm ${input:env} --export=adhoc --servers=${input:servers}",
      "problemMatcher": [],
      "icon": {
        "id": "device-mobile",
        "color": "terminal.ansiBlue"
      }
    },
    {
      "label": "Build: iOS IPA (App Store / TestFlight)",
      "type": "shell",
      "group": "build",
      "command": "fvm dart run tool/build.dart ipa balsm ${input:env} --export=appstore --servers=${input:servers}",
      "problemMatcher": [],
      "icon": {
        "id": "cloud-upload",
        "color": "terminal.ansiBlue"
      }
    },
    {
      "label": "Build: iOS archive only (export in Xcode Organizer)",
      "type": "shell",
      "group": "build",
      "command": "fvm dart run tool/build.dart ipa balsm ${input:env} --export=none --servers=${input:servers}",
      "problemMatcher": [],
      "icon": {
        "id": "archive",
        "color": "terminal.ansiYellow"
      }
    }
  ],
  "inputs": [
    {
      "id": "env",
      "description": "Which environment config (env/balsm/*.json)",
      "type": "pickString",
      "options": [
        "dev",
        "staging",
        "prod"
      ],
      "default": "dev"
    },
    {
      "id": "servers",
      "description": "Which server list (env/*.json) — tunnel adds the devtunnel + LAN presets",
      "type": "pickString",
      "options": [
        "shared",
        "shared.tunnel"
      ],
      "default": "shared"
    }
  ]
}
