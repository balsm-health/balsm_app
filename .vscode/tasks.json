{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: widget tests",
      "type": "shell",
      "command": "flutter",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/app" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Flutter: all UI tests",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ui_test.sh",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
