{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: widget tests",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/flutter.sh",
      "args": ["test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Flutter: all UI tests",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ui_test.sh",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Flutter: build APK (balsm · dev)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/flutter.sh",
      "args": ["apk", "balsm", "dev"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Flutter: build APK (balsm · prod)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/flutter.sh",
      "args": ["apk", "balsm", "prod"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Flutter: build web (balsm · prod)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/flutter.sh",
      "args": ["web", "balsm", "prod"],
      "group": "build",
      "problemMatcher": []
    }
  ]
