{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: widget tests",
      "type": "shell",
      "command": "flutter",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/app" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Flutter: UI driver tests",
      "type": "shell",
      "command": "flutter",
      "args": [
        "drive",
        "--target=test_driver/main_patient_driver.dart",
        "--driver=test_driver/main_patient_driver_test.dart"
      ],
      "options": { "cwd": "${workspaceFolder}/app" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Flutter: all UI tests",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ui_test.sh",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
