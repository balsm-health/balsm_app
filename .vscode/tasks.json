{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: code generation",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/build.dart",
        "gen"
      ],
      "problemMatcher": []
    },
    {
      "label": "Flutter: code generation (watch)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/build.dart",
        "gen",
        "--watch"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Flutter: widget tests (app only)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/build.dart",
        "test"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Flutter: all UI tests",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ui_test.sh",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Flutter: build APK (balsm \u00b7 dev)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/build.dart",
        "apk",
        "balsm",
        "dev"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Flutter: build APK (balsm \u00b7 prod)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/build.dart",
        "apk",
        "balsm",
        "prod"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: build web (balsm \u00b7 prod)",
      "type": "shell",
      "command": "dart",
      "args": [
        "run",
        "tool/build.dart",
        "web",
        "balsm",
        "prod"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Dart: format",
      "type": "shell",
      "command": "dart",
      "args": [
        "format",
        "."
      ],
      "group": "format",
      "problemMatcher": []
    },
    {
      "label": "Flutter: all tests",
      "detail": "Every Dart test in the repo: each workspace package, then the root suites.",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/all_tests.sh",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
