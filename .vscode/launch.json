{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Balsm Patient App",
      "request": "launch",
      "type": "dart",
      "cwd": "app",
      "program": "${input:patientEntrypoint}",
      "flutterMode": "debug",
      "args": [
        "--flavor",
        "dev",
        "--dart-define-from-file=env/balsm/dev.json",
        "--dart-define-from-file=env/envs.json"
      ]
    }
  ],
  "inputs": [
    {
      "id": "patientEntrypoint",
      "type": "pickString",
      "description": "Patient app entrypoint",
      "options": [
        "lib/main_patient.dart",
        "test_driver/main_patient_driver.dart"
      ],
      "default": "lib/main_patient.dart"
    }
  ]
}
