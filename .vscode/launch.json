{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Balsm",
      "request": "launch",
      "type": "dart",
      "cwd": "app",
      "program": "lib/brands/balsm/main_balsm.dart",
      "flutterMode": "debug",
      "args": [
        "--flavor",
        "balsm",
        "--dart-define-from-file=env/balsm/dev.json",
        "--dart-define-from-file=env/shared.json"
      ]
    },
    {
      // No --flavor: the macOS project is unflavored, and the flag makes
      // Flutter's SwiftPM migrator abort ("You must specify a --flavor
      // option"). Same reason bin/balsm drops it for desktop devices.
      "name": "Debug Balsm (macOS)",
      "request": "launch",
      "type": "dart",
      "cwd": "app",
      "program": "lib/brands/balsm/main_balsm.dart",
      "flutterMode": "debug",
      "deviceId": "macos",
      "args": [
        "--dart-define-from-file=env/balsm/dev.json",
        "--dart-define-from-file=env/shared.json"
      ]
    }
  ]
}
