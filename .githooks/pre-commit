#!/bin/sh
# Balsm pre-commit — two guards:
#   1. no machine-specific absolute paths in staged content
#   2. every staged *.dart is `dart format`-clean
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Width follows `formatter: page_width` in analysis_options.yaml when set,
# else dart's default. To auto-fix:  dart format . && git add -u
# Bypass in a genuine emergency:  git commit --no-verify  (discouraged).

# ---------------------------------------------------------------------------
# 1. Machine-specific absolute paths.
#
# A checkout location is one developer's accident, not a fact about the repo.
# An absolute path into somebody's checkout is wrong in every other clone and
# on CI, and it silently leaks the author's directory layout. Write
# repo-relative paths, `$(git rev-parse --show-toplevel)`, or `../<sibling>`
# for another repo in the workspace.
#
# Only ADDED lines are scanned, so existing content never blocks an unrelated
# commit. The one blanket exclusion is the vendored `*/skills/**` trees, which
# are installed third-party content. Nothing else is excluded: the patterns
# below are written with character classes so this file does not match itself,
# which is what lets the check run over its own definition. Self-exemptions are
# how 146 bad paths once hid in `.claude/agents/**`.
added=$(git diff --cached --diff-filter=ACM -U0 -- . \
          ':(exclude).agents/skills/**' ':(exclude).claude/skills/**' \
          ':(exclude).agent/skills/**' ':(exclude).qwen/skills/**' \
          ':(exclude).cursor/skills/**' ':(exclude)plugin/skills/**' \
        | grep '^+' | grep -v '^+++')

# Mount roots and Windows user directories are always machine paths. The unix
# home directories count only when followed by a name segment, so an import
# like `@/pages/Users/...` or prose like "medications/home/profile" does not
# trip the guard.
#
# A line may opt out with a trailing `machine-path-ok` marker, for the cases
# where an absolute path IS the subject: a test asserting a path is redacted,
# a mounted installer volume, an illustrative CLI transcript.
bad=$(printf '%s\n' "$added" \
  | grep -vF 'machine-path-ok' \
  | grep -nE '/Vol[u]mes/|[A-Za-z]:\\Us[e]rs\\|(^|[^A-Za-z0-9_.-])/(Us[e]rs|ho[m]e)/[A-Za-z_][A-Za-z0-9_-]*/|~/D[e]v/')

if [ -n "$bad" ]; then
  echo ""
  echo "✖ pre-commit: machine-specific absolute path in staged content."
  printf '%s\n' "$bad" | sed 's/^/    /' | cut -c1-140
  echo ""
  echo "  Use a repo-relative path, \"\$(git rev-parse --show-toplevel)\", or"
  echo "  ../<sibling-repo> for another repo in the workspace."
  echo "  If the path IS the point, add  machine-path-ok  to that line."
  echo "  (Override only if you must:  git commit --no-verify)"
  exit 1
fi

# ---------------------------------------------------------------------------
# 2. Dart formatting.
# Prefer fvm's dart (repo standard), else fall back to PATH dart.
if command -v fvm >/dev/null 2>&1; then
  DART="fvm dart"
elif command -v dart >/dev/null 2>&1; then
  DART="dart"
else
  echo "pre-commit: no dart on PATH (install fvm or the Dart SDK); skipping format check." >&2
  exit 0
fi

# Staged, still-present Dart files (added/copied/modified), minus generated
# output (build_runner writes `// dart format off` files that would otherwise
# re-trigger this on every regen — the analyzer excludes them too).
staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.dart' \
  | grep -vE '\.(i69n|g|freezed|mocks|config)\.dart$')
[ -z "$staged" ] && exit 0

# --set-exit-if-changed makes dart exit non-zero if any file would be reformatted.
if ! printf '%s\n' "$staged" | xargs $DART format --output=none --set-exit-if-changed; then
  echo ""
  echo "✖ pre-commit: staged Dart files are not formatted."
  echo "  Fix with:  dart format . && git add -u"
  echo "  (Override only if you must:  git commit --no-verify)"
  exit 1
fi

exit 0
