#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Universal Links host. Runner.entitlements declares `applinks:$(BASE_URL)`;
// without this definition it expanded to an empty `applinks:` and iOS never
// associated the app with any domain, so https deep links opened Safari.
// Mirrors manifestPlaceholders["BASE_URL"] in android/app/build.gradle.kts.
BASE_URL = app.balsm.health
