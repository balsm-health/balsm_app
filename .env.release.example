# Credentials for tool/release_local.sh (local store uploads).
#
#   cp .env.release.example .env.release && chmod 600 .env.release
#
# .env.release is git-ignored; never commit it. KEY=value lines, never sourced.
# A value can be plain, `keychain:<service>` (read from the login keychain;
# store one with `security add-generic-password -s <service> -a "$USER" -w`)
# or `file:<path>` (first line of that file). Paths may start with ~.
# Keep the files themselves outside the repo (an encrypted disk image works).
# What each value is: docs/releasing.md → Releasing from a Mac, docs/ci-secrets.md.

# iOS → App Store Connect / TestFlight
APPLE_TEAM_ID=
APPLE_DIST_CERT_P12=
APPLE_DIST_CERT_PASSWORD=keychain:balsm-apple-dist-p12
APPSTORE_PROFILE=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_FILE=

# Android upload key: an existing key.properties (storeFile, keyAlias, passwords)…
ANDROID_KEY_PROPERTIES=
# …or each value on its own:
# ANDROID_KEYSTORE=
# ANDROID_KEY_ALIAS=upload
# ANDROID_STORE_PASSWORD=keychain:balsm-android-store
# ANDROID_KEY_PASSWORD=keychain:balsm-android-key

# Google Play
PLAY_SERVICE_ACCOUNT_JSON_FILE=

# Huawei AppGallery
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=keychain:balsm-huawei-client-secret
HUAWEI_APP_ID=

# Web deploy, production only (--stores=web): Cloudflare API token
# (Edit Cloudflare Workers template, the balsm.health account and zone)
CLOUDFLARE_API_TOKEN=keychain:balsm-cloudflare-token

# Server list, used when app/env/shared.json is missing (optional)
SHARED_ENV_JSON_FILE=
