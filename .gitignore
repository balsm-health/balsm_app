.DS_Store

# Dart/Flutter build + tool artifacts (all packages)
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Flutter native tooling — machine-generated (absolute SDK paths), regenerated
# by `fvm flutter pub get`; must never be committed. Covers every package
# (app, modules/*) so newly-scaffolded modules can't leak them again.
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*

# fvm — pin (.fvmrc) is committed; the SDK symlink + cached versions are local
.fvm/

# Signing material — provisioned by CI from secrets, never committed
**/key.properties
*.jks
*.keystore
*.p12
*.mobileprovision
**/coverage/
*.log
app/ios/Runner/Runner.entitlements.prod.bak
.gstack/

# iOS signing config — team id and provisioning profile names.
# Ignore the whole folder and re-admit only the templates, so anything dropped
# in here later (a .p12, a .mobileprovision, an App Store Connect key) is
# ignored by default rather than needing a new rule each time.
app/ios/signing/*
!app/ios/signing/adhoc.plist
!app/ios/signing/appstore.plist
!app/ios/signing/README.md

# Collected build artifacts (tool/build.dart) — reproducible from source.
/output/

# Build-time config: server URLs and the Sentry DSN. Local to each machine —
# `shared*.json` also covers per-developer variants (e.g. shared.tunnel.json
# for a devtunnel). See app/env/README.md for the shape.
app/env/shared*.json
# …except the template a fresh clone copies from.
!app/env/shared.example.json
# Widget Preview related
.widget_preview/

# claude.ai/design fetch cache (baseline in synced/ is committed)
.design-sync/current/
