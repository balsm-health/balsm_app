// Balsm Pro web app + deep-link verification files on pro.balsm.health.
//
//   balsm web balsm_pro <env> --base-href=/      # builds app/build/web
//   npx wrangler deploy -c deploy/web/wrangler.balsm_pro.jsonc
//
// Same Worker and same layout as the patient app (wrangler.jsonc), on a host
// of its own: browsers isolate storage and sessions by host, so two apps
// holding different people's health data never share one. See
// docs/app-update.md and AppBrand.webHost.
//
// Not deployable yet: there is no balsm_pro entrypoint or build flavor
// (tool/build_config.dart), and no app/web/version/balsm_pro.json. This file
// is the recipe for when there is. app/build/web holds one brand's build at a
// time — build Pro, deploy Pro.
{
  "name": "balsm-pro-web",
  "account_id": "11f27ce927c9ed271353738cc6f9d002",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  "assets": {
    "directory": "../../app/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/version/*", "/whats-new"]
  },
  "vars": {
    "DEFAULT_BRAND": "balsm_pro",
    // Same source branch as the patient app; switch both to main together.
    "VERSION_SOURCE_BASE": "https://raw.githubusercontent.com/balsm-health/balsm_app/feature/mvp/app/web/version"
  },
  "routes": [{ "pattern": "pro.balsm.health", "custom_domain": true }]
}
